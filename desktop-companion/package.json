{
  "name": "dzongkha-dictionary-desktop",
  "version": "3.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "stage": "node scripts/stage-app.mjs",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:macos:fast": "tauri build --bundles app,dmg --config src-tauri/tauri.ci.conf.json",
    "build:macos": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "build:windows": "tauri build --bundles nsis",
    "build:windows:ci": "tauri build --bundles nsis --config src-tauri/tauri.ci.conf.json",
    "icons": "tauri icon app-icon.png",
    "test:rust": "npm run stage && cargo test --manifest-path src-tauri/Cargo.toml",
    "prepare:ci-release": "node scripts/prepare-ci-version.mjs",
    "verify:release": "node scripts/verify-release-version.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3"
  }
}
