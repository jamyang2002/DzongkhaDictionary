{
  "name": "dzongkha-dictionary-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "stage": "node scripts/stage-app.mjs",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:macos": "tauri build --bundles app,dmg",
    "build:windows": "tauri build --bundles nsis,msi",
    "build:windows:ci": "tauri build --bundles nsis,msi --config src-tauri/tauri.ci.conf.json",
    "icons": "tauri icon app-icon.png",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "verify:release": "node scripts/verify-release-version.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3"
  }
}
