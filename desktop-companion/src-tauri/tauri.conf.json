{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dzongkha Dictionary",
  "version": "1.0.0",
  "identifier": "bt.gov.dzongkha.dictionary",
  "build": {
    "beforeDevCommand": "npm run stage",
    "beforeBuildCommand": "npm run stage",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dzongkha Dictionary",
        "url": "index.html",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Education",
    "shortDescription": "Dzongkha and English dictionary with system-wide Quick Lookup",
    "longDescription": "Dzongkha Dictionary with offline dictionary data and a GoldenDict-style system-wide double-copy Quick Lookup popup.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxNEYzQzUwNkM2RTVFMDMKUldRRFhtNXNVRHhQVWJiLzlCOFh2V0hjMGw1U2QwcHRQOVE2Qmg2TTFjbVo1bEtVZE1TUXJCWGQK",
      "endpoints": [
        "https://github.com/jamyang2002/DzongkhaDictionary/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
