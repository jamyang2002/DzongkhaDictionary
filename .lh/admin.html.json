            "name": "Commit-0",
            "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Admin — Dzongkha Dictionary</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <style>\n    body { padding: 24px; font-family: Inter, system-ui, sans-serif; max-width: 1200px; margin: 0 auto; }\n    label { display: block; margin: 12px 0 4px; font-weight: 600; }\n    input, select, textarea { width: 100%; padding: 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); color: var(--text); }\n    .admin-nav { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid var(--line); padding-bottom: 10px; }\n    .admin-tab { padding: 8px 16px; cursor: pointer; border-radius: 6px; border: none; background: none; color: var(--muted); font-weight: 700; }\n    .admin-tab.active { background: var(--accent-soft); color: var(--accent); }\n    .data-table { width: 100%; border-collapse: collapse; margin-top: 20px; }\n    .data-table th, .data-table td { padding: 12px; border: 1px solid var(--line); text-align: left; }\n    .data-table th { background: var(--panel-soft); font-size: 0.8rem; text-transform: uppercase; }\n    .action-btns { display: flex; gap: 5px; }\n    .btn-edit { color: var(--gold); border-color: var(--gold); }\n    .btn-del { color: var(--danger); border-color: var(--danger); }\n    .modal { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 100; }\n    .modal-content { background: var(--panel); padding: 24px; border-radius: 12px; width: 500px; max-width: 90vw; max-height: 90vh; overflow-y: auto; }\n    [hidden] { display: none !important; }\n  </style>\n</head>\n<body>\n  <h1>Admin</h1>\n  <p>Manage app notifications and dictionary entries.</p>\n  \n  <div id=\"authPanel\">\n    <label>Secret Key: <input id=\"secret\" type=\"password\" placeholder=\"Enter 'admin' to unlock\"></label>\n  </div>\n\n  <div id=\"adminPanel\" hidden>\n    <nav class=\"admin-nav\">\n      <button class=\"admin-tab active\" data-target=\"notifSection\">Notifications</button>\n      <button class=\"admin-tab\" data-target=\"entrySection\">Dictionary Management</button>\n    </nav>\n\n    <!-- Notification Section -->\n    <section id=\"notifSection\">\n      <label>New Notification: <textarea id=\"notifText\" rows=\"2\"></textarea></label>\n      <button id=\"postNotif\" class=\"primary-button\">Post Message</button>\n      <h2>History</h2>\n      <ul id=\"notifList\"></ul>\n    </section>\n\n    <!-- Dictionary Entry Section -->\n    <section id=\"entrySection\" hidden>\n      <div class=\"utility-row\">\n        <select id=\"dictSelector\" style=\"width: 200px;\">\n          <option value=\"dzEn\">Dzongkha → English</option>\n          <option value=\"enDz\">English → Dzongkha</option>\n          <option value=\"dzDz\">Dzongkha → Dzongkha</option>\n          <option value=\"tenses\">Tenses</option>\n        </select>\n        <input id=\"adminSearch\" type=\"text\" placeholder=\"Search entries to edit...\" style=\"flex: 1;\">\n        <button id=\"addNewBtn\" class=\"primary-button\">+ Add New Entry</button>\n        <button id=\"exportDataBtn\" class=\"secondary-button\">Export updated JSON</button>\n      </div>\n\n      <table class=\"data-table\">\n        <thead>\n          <tr>\n            <th>Root Word</th>\n            <th>Equivalent / Meaning</th>\n            <th>Actions</th>\n          </tr>\n        </thead>\n        <tbody id=\"entryList\"></tbody>\n      </table>\n    </section>\n  </div>\n\n  <!-- Entry Edit Modal -->\n  <div id=\"editModal\" class=\"modal\" hidden>\n    <div class=\"modal-content\">\n      <h2 id=\"modalTitle\">Edit Entry</h2>\n      <form id=\"entryForm\">\n        <div id=\"formFields\"></div>\n        <div class=\"utility-row\" style=\"margin-top: 20px;\">\n          <button type=\"submit\" class=\"primary-button\">Save Changes</button>\n          <button type=\"button\" id=\"closeModal\" class=\"secondary-button\">Cancel</button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <script src=\"admin.js\"></script>\n</body>\n</html>\n"
        }
    ]
